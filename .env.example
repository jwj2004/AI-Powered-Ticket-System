# LLM（OpenAI 兼容，默认 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=10

# A 的检索服务；USE_MOCK_RETRIEVE=true 时用 B 内置文档块
RETRIEVE_BASE_URL=http://127.0.0.1:8000
USE_MOCK_RETRIEVE=true
# 文档块相似度阈值：低于 medium 视为证据不足
HIGH_SCORE_THRESHOLD=0.75
MEDIUM_SCORE_THRESHOLD=0.45

# 检索增强
RETRIEVE_CANDIDATE_K=10
ENABLE_QUERY_REWRITE=true
ENABLE_HYBRID_RETRIEVE=true
ENABLE_CROSS_ENCODER=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 热门问题缓存：同一问题累计命中达到阈值后直接返回
HOT_CACHE_MIN_HITS=3

# B 会话 / 缺口 / 通知
DATABASE_PATH=./backend/data/zhida_b.db

# 必须与 A 的 JWT_SECRET 一致
JWT_SECRET=zhida-jwt-shared-2026
JWT_EXPIRE_MINUTES=1440
